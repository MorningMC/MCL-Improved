<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <property name="pattern">%d{yyyy-MM-dd}T%d{HH:mm:ss:SSSZZ} %-5level [%t] %logger.%M:%L - %msg%n</property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${pattern}" />
        </Console>

        <RollingFile name="File" fileName="${env:APPDATA}/.mcli/logs/latest.log" filePattern="${env:APPDATA}/.mcli/logs/%d{yyyy_MM_dd.HH_mm_ss_SSS}.log" append="true">
            <Policies>
                <OnStartupTriggeringPolicy minSize="1"/>
            </Policies>
            <PatternLayout pattern="${pattern}" />
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="debug">
            <AppenderRef ref="Console" />
            <AppenderRef ref="File" />
        </Root>
    </Loggers>
</Configuration>